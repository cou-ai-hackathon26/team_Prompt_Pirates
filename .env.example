# Copy to .env and fill in. Keep .env out of git.
# When adding variables, update src/env.js too.

# --- Database ---
# Local Docker (./start-database.sh): both URLs the same.
# Supabase: DATABASE_URL = "Transaction pooler" URL (port 6543) + ?pgbouncer=true
#           DIRECT_URL   = "Direct connection" / session URL (port 5432)
DATABASE_URL="postgresql://postgres:password@localhost:5432/denguesathi"
DIRECT_URL="postgresql://postgres:password@localhost:5432/denguesathi"

# --- AI (free tiers) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional failover keys from OTHER Google Cloud projects (keys in one project share its quota)
GEMINI_BACKUP_API_KEYS=""   # "key2,key3"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.5-flash"

# Optional fallback: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_STT_MODEL="whisper-large-v3"
GROQ_TEXT_MODEL="openai/gpt-oss-120b"
GROQ_VISION_MODEL="qwen/qwen3.8-27b"

# --- Staff login for /dashboard (Google, via Auth.js) ---
# Google Cloud Console -> Google Auth Platform -> Clients -> Web application.
# Redirect URIs: http://localhost:3000/api/auth/callback/google
#                https://<your-domain>/api/auth/callback/google
AUTH_SECRET=""        # npx auth secret  (or: openssl rand -base64 32)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Who may open the dashboard (comma-separated). Empty = nobody (families can sign in too).
STAFF_EMAILS=""
